{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv313/Scripts/python.exe",
      "runtimeArgs": [
        "-u",
        "-m",
        "uvicorn",
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--log-config",
        ".claude/logging.json"
      ],
      "port": 8000
    },
    {
      "name": "logs",
      "runtimeExecutable": ".venv313/Scripts/python.exe",
      "runtimeArgs": ["-u", ".claude/logview.py"],
      "port": 8765
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
